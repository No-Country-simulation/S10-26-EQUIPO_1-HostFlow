# ==============================================================================
# HostFlow - Plantilla de variables de entorno
# ==============================================================================
# Uso:
#   1. Copia este archivo como ".env" en la misma carpeta (backend/).
#   2. Reemplaza los valores CAMBIAR_* con tus credenciales locales.
#   3. NO subas el archivo ".env" al repositorio.
#
# Spring Boot carga backend/.env automáticamente al iniciar.
# ==============================================================================

# ---------- PostgreSQL ----------
# Usuario de PostgreSQL con acceso a la base "hostflow_dev".
# Por defecto "postgres", o el usuario que uses en tu máquina.
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# ---------- Seguridad / JWT ----------
# Clave usada para firmar los JWT (equivale a jwt.secret en application.properties).
# HS512 exige un mínimo de 64 caracteres. Puedes generar una nueva con:
#   openssl rand -hex 48
JWT_SECRET=51c9dbfe7e1a8433c499756688c6bf224ae4fce5ecc781595c06a7c2866ec63a7aa516a0a7b6701fb6ca5402c361843f
# Clave inicial del usuario administrador (admin@hostflow.com).
# Define una clave propia; nunca dejes credenciales reales en el repositorio.
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE_ADMIN

# ---------- Correo (opcional en desarrollo) ----------
# Para Gmail usa una "Contraseña de aplicación", no tu clave normal.
# Si activas el perfil "dev", el SMTP apunta a Mailtrap: usa aquí las
# credenciales de tu inbox de Mailtrap.
MAIL_USERNAME=CAMBIAR_ESTE_CORREO
MAIL_PASSWORD=CAMBIAR_ESTA_APP_PASSWORD

# ---------- Perfil (opcional) ----------
# Descomenta para usar application-dev.properties (Mailtrap, logs DEBUG):
# spring.profiles.active=dev
