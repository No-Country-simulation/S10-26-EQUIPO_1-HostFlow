# ==============================================================================
# HostFlow - Plantilla de variables de entorno
# ==============================================================================
# Uso:
#   1. Copia este archivo como ".env" en la carpeta backend/ (o raíz del proceso).
#   2. Reemplaza los valores CAMBIAR_* con tus credenciales locales.
#   3. NO subas el archivo ".env" al repositorio.
#
# Spring Boot lo carga vía spring.config.import (optional:file:.env[.properties]).
# ==============================================================================

# ---------- Perfil (opcional en local) ----------
# Descomenta para forzar application-dev.properties:
# SPRING_PROFILES_ACTIVE=dev

# ---------- PostgreSQL ----------
DB_URL=jdbc:postgresql://localhost:5432/hostflow_dev
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# ---------- Seguridad / JWT ----------
# HS512 exige mínimo ~64 caracteres. Generar con:
#   openssl rand -hex 48
JWT_SECRET=CAMBIAR_JWT_SECRET_MINIMO_64_CARACTERES_USAR_OPENSSL_RAND_HEX_48
# Nota: DataInitializer usa hoy una clave hardcodeada para el admin inicial.
# ADMIN_PASSWORD en .env no se aplica hasta cablear app.admin.password en Java.

# ---------- Correo (Gmail App Password + Brevo opcional) ----------
# Gmail: contraseña de aplicación de 16 caracteres (no la clave normal).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_ESTE_CORREO@gmail.com
MAIL_PASSWORD=CAMBIAR_APP_PASSWORD_16_CARACTERES
# Si defines BREVO_API_KEY, EmailService prioriza la API de Brevo sobre SMTP.
BREVO_API_KEY=

# ---------- Cloudinary ----------
# https://console.cloudinary.com/ → API Keys
CLOUDINARY_CLOUD_NAME=CAMBIAR_CLOUD_NAME
CLOUDINARY_API_KEY=CAMBIAR_API_KEY
CLOUDINARY_API_SECRET=CAMBIAR_API_SECRET
CLOUDINARY_FOLDER=hostflow

# ---------- Límites de imágenes ----------
APP_IMAGES_MAX_SIZE_BYTES=2097152

# ---------- Frontend / URLs públicas ----------
APP_EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000/verify-email
APP_EMAIL_VERIFICATION_BACKEND_URL=http://localhost:8080/api/v1/auth/verify-email
APP_RESERVATIONS_FRONTEND_CONFIRM_URL=http://localhost:5173/reservations/confirm

# ---------- Solo producción (ejemplo; definir en el panel del host) ----------
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://...
# DB_USERNAME=...
# DB_PASSWORD=...
# JWT_SECRET=...
# BREVO_API_KEY=...
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# APP_EMAIL_VERIFICATION_FRONTEND_URL=https://tu-frontend.com/verify-email
# APP_EMAIL_VERIFICATION_BACKEND_URL=https://tu-api.com/api/v1/auth/verify-email
# APP_RESERVATIONS_FRONTEND_CONFIRM_URL=https://tu-frontend.com/reservations/confirm
